# 监听地址与三个下游地址；Settings 代码默认值与本文件保持一致
RTVA_HOST=0.0.0.0
RTVA_PORT=8000
RTVA_KEEP_ALIVE_SECONDS=10
RTVA_ASR_BASE_URL=http://127.0.0.1:8001
RTVA_THINKER_BASE_URL=http://127.0.0.1:8002
RTVA_TTS_BASE_URL=http://127.0.0.1:9000
RTVA_ALLOWED_SAMPLE_RATES=[16000,24000,48000]
# 网关并发/容量配置
RTVA_MAX_SESSIONS=30
RTVA_CPU_WORKERS=8
RTVA_CPU_PENDING_JOBS=256
# 下游准入并发（同时在途请求数）与有界等待队列长度
RTVA_ASR_CONCURRENCY=30
RTVA_ASR_MAX_WAITERS=30
RTVA_THINKER_CONCURRENCY=30
RTVA_THINKER_MAX_WAITERS=64
RTVA_THINKER_FALLBACK_ENABLED=true
RTVA_THINKER_FALLBACK_TEXT_1=抱歉，我刚刚没反应过来，可以再说一遍吗？
RTVA_THINKER_FALLBACK_TEXT_2=不好意思，我刚才走神了，麻烦你再说一次吧。
RTVA_THINKER_FALLBACK_TEXT_3=抱歉，刚才没有回答上来，请再问我一次好吗？
RTVA_THINKER_FALLBACK_TONE=平和、自然、略带歉意
RTVA_TTS_CONCURRENCY=30
RTVA_TTS_MAX_WAITERS=64
RTVA_TTS_FIRST_AUDIO_TIMEOUT_SECONDS=5
RTVA_TTS_IDLE_TIMEOUT_SECONDS=5
RTVA_HANDSHAKE_TIMEOUT_SECONDS=5
RTVA_SESSION_EVENT_QUEUE_SIZE=256
RTVA_SESSION_AUDIO_QUEUE_SIZE=64
RTVA_SESSION_ASR_QUEUE_SIZE=64
RTVA_SESSION_OUTBOUND_QUEUE_SIZE=256
RTVA_SESSION_AUDIO_QUEUE_MAX_SECONDS=3
RTVA_SESSION_OUTBOUND_QUEUE_MAX_BYTES=8388608
RTVA_THINKER_CLEANUP_TIMEOUT_SECONDS=25
RTVA_THINKER_STREAM_TIMEOUT_SECONDS=5
RTVA_THINKER_REPLY_TOTAL_TIMEOUT_SECONDS=20
RTVA_TTS_DRAIN_TIMEOUT_SECONDS=0.01
# 下游 /health 后台探测（/health 路由只读缓存，不做网络等待）
RTVA_DOWNSTREAM_PROBE_INTERVAL_SECONDS=10
RTVA_DOWNSTREAM_PROBE_TIMEOUT_SECONDS=2
RTVA_SLOW_STAGE_WARNING_SECONDS=2
# 非空时透传给 TTS 的 prompt_override，跳过其内部 qwen-flash prompt 生成（消除 ~18s 首块延迟）
RTVA_TTS_PROMPT_OVERRIDE=

# VAD 片段中累计的有效人声低于此值会直接丢弃，单位毫秒。
RTVA_VAD_MIN_SPEECH_MS=200

# 会话级说话人验证：使用 WeSpeaker 导出的 16kHz ONNX 模型。
# 开启前请把模型放到 RTVA_SPEAKER_MODEL_PATH 指定的位置。
RTVA_SPEAKER_VERIFICATION_ENABLED=false
RTVA_SPEAKER_MODEL_PATH=models/wespeaker/cnceleb_resnet34.onnx
RTVA_SPEAKER_VERIFICATION_THRESHOLD=0.65
RTVA_SPEAKER_REGISTER_MIN_AUDIO_MS=2000
RTVA_SPEAKER_VERIFICATION_MIN_AUDIO_MS=800
RTVA_SPEAKER_CONCURRENCY=4
RTVA_SPEAKER_MAX_WAITERS=32
# 模型异常时 true 表示不阻断对话，false 表示直接过滤该片段。
RTVA_SPEAKER_FAIL_OPEN=true

# Semantic end-of-turn detection (local pinned LiveKit multilingual ONNX model)
RTVA_TURN_END_SEMANTIC_ENABLED=true
RTVA_TURN_END_CANDIDATE_SILENCE_MS=500
RTVA_TURN_END_MIN_SILENCE_MS=0
RTVA_TURN_END_MAX_SILENCE_MS=2000
RTVA_TURN_END_INFERENCE_TIMEOUT_MS=500
RTVA_TURN_END_MODEL_PATH=models/turn-end-livekit
RTVA_TURN_END_LANGUAGE=zh
# Omit to use the model's language threshold (zh: 0.0066)
# RTVA_TURN_END_COMPLETE_THRESHOLD=0.0066
RTVA_TURN_END_CONCURRENCY=30
RTVA_TURN_END_MAX_PENDING_JOBS=32
RTVA_TURN_END_MAX_UTTERANCE_SECONDS=30
RTVA_TURN_END_CPU_THREADS=16
